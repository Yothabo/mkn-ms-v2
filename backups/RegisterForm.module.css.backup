/* RegisterForm Styles - Self Contained */

/* Container */
.registerContainer {
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex: 1;
  margin: 0 auto;
  padding: var(--spacing-xl) 0;
  min-height: min-content;
  max-width: 400px;
}

/* Header */
.registerHeader {
  text-align: center;
  margin-bottom: var(--spacing-lg);
  width: 100%;
  flex-shrink: 0;
}

.registerHeader h2 {
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-text);
  margin: 0 0 var(--spacing-xs) 0;
}

.registerHeader p {
  font-size: var(--font-size-base);
  color: var(--color-text-light);
  margin: 0;
}

/* Form */
.registerForm {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
  width: 100%;
  margin: var(--spacing-xl) 0;
  flex: 1;
  min-height: min-content;
}

/* Input Group */
.registerInputGroup {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.registerInputGroup label {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text);
}

/* Input */
.registerInput {
  padding: var(--spacing-md);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  transition: border-color var(--transition-normal);
  background: transparent !important;
}

.registerInput:focus {
  outline: none;
  border-color: var(--color-secondary);
  background: transparent !important;
}

.registerInput:hover {
  border-color: var(--color-secondary);
  background: transparent !important;
}

.registerInput:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  background: transparent !important;
}

.registerInput::placeholder {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  opacity: 0.8;
}

/* Error Message */
.registerErrorMessage {
  background: var(--color-error-light);
  color: var(--color-error);
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  text-align: center;
  width: 100%;
  margin: var(--spacing-md) 0;
}

/* Submit Button */
.registerSubmitButton {
  width: 100%;
  margin: var(--spacing-lg) 0;
}

/* Footer */
.registerFooter {
  padding-top: var(--spacing-xl);
  border-top: 1px solid var(--color-border);
  text-align: center;
  width: 100%;
  margin-top: auto;
  flex-shrink: 0;
}

.registerSwitchText {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  margin: 0 0 var(--spacing-md) 0;
}

/* Link Button */
.registerLinkButton {
  background: none;
  border: none;
  color: var(--color-secondary);
  cursor: pointer;
  font-size: inherit;
  text-decoration: underline;
  transition: color var(--transition-normal);
  white-space: nowrap;
  padding: var(--spacing-xs);
  border-radius: var(--radius-sm);
}

.registerLinkButton:hover:not(:disabled) {
  color: var(--color-secondary-hover);
}

.registerLinkButton:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Responsive styles */
@media (max-width: 768px) {
  .registerContainer {
    padding: var(--spacing-2xl) 0;
    justify-content: flex-start;
    min-height: auto;
  }

  .registerHeader {
    margin-bottom: var(--spacing-xl);
  }

  .registerHeader h2 {
    font-size: var(--font-size-xl);
  }

  .registerForm {
    margin: var(--spacing-xl) 0;
    gap: var(--spacing-lg);
    justify-content: flex-start;
  }

  .registerInput {
    padding: var(--spacing-sm) var(--spacing-md);
    height: 2.5rem;
  }

  .registerInput::placeholder {
    font-size: var(--font-size-xs);
  }

  .registerFooter {
    padding-top: var(--spacing-lg);
    margin-top: auto;
  }

  .registerErrorMessage {
    margin: var(--spacing-md) 0;
  }
}

@media (max-width: 480px) {
  .registerContainer {
    padding: calc(var(--spacing-2xl) * 1.2) 0;
  }

  .registerHeader h2 {
    font-size: var(--font-size-lg);
  }

  .registerHeader p {
    font-size: var(--font-size-sm);
  }

  .registerFooter {
    margin-top: auto;
  }

  .registerForm {
    margin: var(--spacing-lg) 0;
  }

  .registerInput::placeholder {
    font-size: var(--font-size-xs);
  }
}

@media (min-width: 769px) {
  .registerHeader {
    margin-bottom: var(--spacing-lg);
  }

  .registerForm {
    margin: var(--spacing-xl) 0;
  }

  .registerContainer {
    justify-content: center;
  }
}
