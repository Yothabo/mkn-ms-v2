/* Auth Base Styles - Using Global CSS Variables Only */
/* No hard-coded values - all variables from global CSS */

/* Base Container */
.auth-base-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  flex: 1;
  margin: 0 auto;
  box-sizing: border-box;
  overflow-y: auto;
}

/* Base Form */
.auth-base-form {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  width: 100%;
  margin: var(--spacing-md) 0;
  flex: 1;
  min-height: min-content;
}

/* Base Header */
.auth-base-header {
  text-align: center;
  margin-bottom: var(--spacing-md);
  width: 100%;
}

.auth-base-header h2 {
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-text);
  margin-bottom: var(--spacing-xs);
  line-height: var(--line-height-tight);
}

.auth-base-header p {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  line-height: var(--line-height-normal);
  margin: 0;
}

/* Base Input Group */
.auth-base-input-group {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
  width: 100%;
}

.auth-input-label {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text);
  text-align: left;
  line-height: var(--line-height-normal);
  margin-bottom: var(--spacing-xs);
}

/* Base Input */
.auth-base-input {
  width: 100%;
  padding: var(--spacing-sm) var(--spacing-md);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  font-family: inherit;
  transition: all var(--transition-normal);
  background: var(--color-background);
  box-sizing: border-box;
  line-height: var(--line-height-normal);
  color: var(--color-text);
  height: 2.75rem;
}

.auth-base-input:focus {
  outline: none;
  border-color: var(--color-secondary);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-secondary) 20%, transparent);
}

.auth-base-input:hover:not(:disabled) {
  border-color: var(--color-secondary);
}

.auth-base-input:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  background-color: var(--color-background-muted);
}

.auth-base-input::placeholder {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  opacity: 0.8;
}

/* Base Error Message */
.auth-base-error-message {
  background-color: color-mix(in srgb, var(--color-status-error) 10%, transparent);
  border: 1px solid var(--color-status-error);
  color: var(--color-status-error);
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-md);
  font-size: var(--font-size-sm);
  text-align: center;
  width: 100%;
  box-sizing: border-box;
  line-height: var(--line-height-normal);
  margin: 0;
}

/* Base Footer */
.auth-base-footer {
  text-align: center;
  margin-top: var(--spacing-md);
  width: 100%;
  padding-top: var(--spacing-md);
  border-top: 1px solid var(--color-border);
}

.auth-base-switch-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  margin: 0;
  line-height: var(--line-height-normal);
}

/* Base Link Button */
.auth-base-link-button {
  background: none;
  border: none;
  color: var(--color-secondary);
  cursor: pointer;
  font-size: inherit;
  font-family: inherit;
  text-decoration: underline;
  transition: color var(--transition-normal);
  white-space: nowrap;
  padding: var(--spacing-xs);
  border-radius: var(--radius-sm);
  line-height: var(--line-height-normal);
}

.auth-base-link-button:hover:not(:disabled) {
  color: var(--color-secondary-hover);
  text-decoration: none;
}

.auth-base-link-button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Base Submit Button */
.auth-base-submit-button {
  width: 100%;
  margin: var(--spacing-md) 0 var(--spacing-sm) 0;
  min-height: 2.75rem;
}

/* Responsive Base */
@media (max-width: 768px) {
  .auth-base-header h2 {
    font-size: var(--font-size-xl);
  }

  .auth-base-form {
    gap: var(--spacing-md);
  }
}
